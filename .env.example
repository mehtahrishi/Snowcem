# MariaDB / MySQL Database Connection
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/YOUR_DATABASE_NAME"

# Admin Authentication (Stateless iron-session)
# SESSION_SECRET must be at least 32 characters long
SESSION_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS"
ADMIN_USER="admin"
ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"